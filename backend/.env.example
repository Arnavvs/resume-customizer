# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the primary model is overloaded or rate-limited
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=120

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:3000
# Optional: regex for extra origins, e.g. Vercel preview deployments
# ALLOWED_ORIGIN_REGEX=https://resume-customizer-.*\.vercel\.app

MAX_UPLOAD_MB=5
RATE_LIMIT_PER_HOUR=60
